<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nibub</groupId>
  <artifactId>globbook-auth</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>

  <name>globbook-auth</name>
  <description>Official Java SDK for "Sign in with Globbook" (OAuth 2.0 authorization-code flow)</description>
  <url>https://github.com/nibub-labs/globbook-auth-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Nibub</name>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/nibub-labs/globbook-auth-java</url>
    <connection>scm:git:https://github.com/nibub-labs/globbook-auth-java.git</connection>
  </scm>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <!--
    Zero runtime dependencies — built on java.net.http.HttpClient (stdlib
    since Java 11) and records (stdlib since Java 16), matching the
    sibling Go/JS/PHP/Python SDKs' "no third-party runtime dependency"
    design. Java 17 (LTS) is the minimum: it's the Spring Boot 3.x
    baseline and widely adopted on Boot 2.x deployments too. Test-only
    dependencies below.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
