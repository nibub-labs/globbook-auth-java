<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nibub</groupId>
  <artifactId>globbook-auth</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>

  <name>globbook-auth</name>
  <description>Official Java SDK for "Sign in with Globbook" (OAuth 2.0 authorization-code flow)</description>
  <url>https://github.com/nibub-labs/globbook-auth-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Nibub</name>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/nibub-labs/globbook-auth-java</url>
    <connection>scm:git:https://github.com/nibub-labs/globbook-auth-java.git</connection>
    <developerConnection>scm:git:git@github.com:nibub-labs/globbook-auth-java.git</developerConnection>
  </scm>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <!--
    Zero runtime dependencies — built on java.net.http.HttpClient (stdlib
    since Java 11) and records (stdlib since Java 16), matching the
    sibling Go/JS/PHP/Python SDKs' "no third-party runtime dependency"
    design. Java 17 (LTS) is the minimum: it's the Spring Boot 3.x
    baseline and widely adopted on Boot 2.x deployments too. Test-only
    dependencies below.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>

  <!--
    Activated only for a Maven Central release (mvn -Prelease deploy), not
    on every CI build — signing/sources/javadoc generation adds real time
    and requires a GPG key + Central credentials that CI's plain test
    matrix (.github/workflows/ci.yml) never needs.
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!--
              GPG signing — required by Maven Central for every published
              artifact. Runs non-interactively via "loopback" pinentry
              mode; the passphrase is supplied on the command line as
              -Dgpg.passphrase (see deploy.yml, sourced from a secret —
              never commit a real passphrase to this file). Passing it any
              other way (e.g. only via setup-java's gpg-passphrase input,
              which just wires settings-security.xml) does NOT work — this
              plugin never reads that file.
            -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <plugin>
            <!--
              Publishes to Maven Central via Sonatype's Central Publisher
              Portal API (the current replacement for the legacy OSSRH
              "close and release a staging repository" flow). Credentials
              come from ~/.m2/settings.xml's <server id="central"> entry
              (see deploy.yml, which writes it from CENTRAL_TOKEN_USERNAME/
              CENTRAL_TOKEN_PASSWORD secrets) — a user token generated at
              https://central.sonatype.com/account, not your account
              password.
            -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.5.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
